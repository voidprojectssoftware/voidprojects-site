{
	"routes": [
		{
			"route": "/_app/immutable/*",
			"headers": {
				"Cache-Control": "public, max-age=31536000, immutable"
			}
		},
		{
			"route": "/o/*",
			"headers": {
				"X-Robots-Tag": "noindex, nofollow, noarchive",
				"Referrer-Policy": "no-referrer",
				"Cache-Control": "no-cache"
			}
		}
	],
	"platform": {
		"apiRuntime": "node:22"
	}
}
